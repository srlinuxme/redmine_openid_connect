<%= title [l(:label_my_account), my_account_path], l(:label_oauth_authorized_application_plural) %>

<% if @applications.any? %>
<div class="autoscroll">
<table class="list">
  <thead><tr>
    <th><%= l(:field_name) %></th>
    <th><%= l(:label_oauth_authorized_on) %></th>
    <th></th>
  </tr></thead>
  <tbody>
  <% @applications.each do |application| %>
    <tr id="application_<%= application.id %>" class="<%= cycle('odd', 'even') %>">
      <td class="name"><%= application.name %></td>
      <td><%= format_time application.created_at %></td>
      <td class="buttons">
        <%= link_to l(:label_oauth_revoke_button), oauth_authorized_application_path(application),
                    data: { confirm: l(:text_oauth_revoke_confirm) }, method: :delete, class: 'icon icon-del' %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
<% else %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>

<% content_for :sidebar do %>
  <% @user = User.current %>
  <%= render partial: 'my/sidebar' %>
<% end %>
